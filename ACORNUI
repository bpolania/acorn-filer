   10 REM ACORNUI - ArmGPT Desktop/TaskWindow serial client
   20 REM --------------------------------------------------
   30 REM WIMP-safe BASIC version: no MODE changes, no full-screen VDU layout.
   40 REM Run it from a RISC OS Desktop TaskWindow or command window.
   50 REM Serial protocol matches ACORN: plain text plus newline.
   60 REM Ctrl-L toggles local/cloud; /quit exits locally.
   70 REM
  100 ON ERROR PROCbye
  110 PROCsetup
  120 PROCintro
  130 PROCloop
  140 PROCbye
  150 END
  160 REM
  170 REM ==================== setup ====================
  180 DEF PROCsetup
  190 SYS "OS_Byte",2,2
  200 VDU 4
  210 SYS "OS_SerialOp",0,4+32,0
  220 SYS "OS_SerialOp",1,0
  230 SYS "OS_SerialOp",5,7
  240 SYS "OS_SerialOp",6,7
  250 mask%=&02:waitmax%=12000:idlegap%=300
  260 maxin%=180:mode$="local":quit%=FALSE
  270 ENDPROC
  280 REM
  290 DEF PROCintro
  300 PRINT
  310 PRINT "ArmGPT Desktop client"
  320 PRINT "Serial link: 9600 baud, 8N1"
  330 PRINT "Commands: /status /mode local  /mode cloud  /quit"
  340 PROCstatus
  350 ENDPROC
  360 REM
  370 DEF PROCstatus
  380 PRINT "Mode: ";mode$
  390 ENDPROC
  400 REM
  410 REM ==================== main loop ====================
  420 DEF PROCloop
  430 REPEAT
  440   PROCprompt
  450   IF NOT quit% THEN PROCsubmit
  460 UNTIL quit%
  470 ENDPROC
  480 REM
  490 DEF PROCprompt
  500 q$=""
  510 COLOUR 0:PRINT "you (";mode$;") > ";
  520 REPEAT
  530   k%=GET
  540   CASE k% OF
  550     WHEN 13:PRINT:done%=TRUE
  560     WHEN 8,127:IF LEN(q$)>0 THEN q$=LEFT$(q$,LEN(q$)-1):VDU 8,32,8
  570     WHEN 12:PRINT:PROCtogglemode:PRINT:COLOUR 0:PRINT "you (";mode$;") > ";q$;
  580     WHEN 27:q$="/quit":PRINT "/quit":done%=TRUE
  590     OTHERWISE
  600       IF k%>=32 AND k%<127 AND LEN(q$)<maxin% THEN q$=q$+CHR$(k%):VDU k%
  610   ENDCASE
  620 UNTIL done%
  630 done%=FALSE
  640 ENDPROC
  650 REM
  660 DEF PROCsubmit
  670 IF q$="" THEN ENDPROC
  680 IF q$="/quit" THEN quit%=TRUE:ENDPROC
  690 PROCnotecmd(q$)
  700 tx$=q$:PROCwire
  710 PROCsend(tx$)
  720 PROCreceive
  730 ENDPROC
  740 REM
  750 DEF PROCtogglemode
  760 LOCAL cmd$
  770 IF mode$="local" THEN cmd$="/mode cloud" ELSE cmd$="/mode local"
  780 PRINT "you > ";cmd$
  790 PROCnotecmd(cmd$)
  800 tx$=cmd$:PROCwire
  810 PROCsend(tx$)
  820 PROCreceive
  830 ENDPROC
  840 REM
  850 DEF PROCnotecmd(t$)
  860 IF t$="/mode local" THEN mode$="local"
  870 IF t$="/mode cloud" OR t$="/mode codex" THEN mode$="cloud"
  880 ENDPROC
  890 REM
  900 DEF PROCwire
  910 IF tx$="/mode cloud" THEN tx$="/mode codex"
  920 IF LEFT$(tx$,7)="/cloud " THEN tx$="/codex "+MID$(tx$,8)
  930 ENDPROC
  940 REM
  950 REM ==================== serial send/receive ====================
  960 DEF PROCsend(t$)
  970 LOCAL i%
  980 FOR i%=1 TO LEN(t$):PROCtx(ASC(MID$(t$,i%,1))):NEXT
  990 PROCtx(13):PROCtx(10)
 1000 ENDPROC
 1010 REM
 1020 DEF PROCtx(b%)
 1030 SYS "OS_SerialOp",3,b%
 1040 ENDPROC
 1050 REM
 1060 DEF PROCreceive
 1070 LOCAL byte%,flags%,start%,last%,got%
 1080 cur$="":lastnl%=0
 1090 COLOUR 4:PRINT "arm > ";:COLOUR 0
 1100 start%=TIME:got%=FALSE
 1110 REPEAT
 1120   PROCwait
 1130   SYS "OS_SerialOp",4 TO ,byte%;flags%
 1140   IF (flags% AND mask%)=0 THEN PROCrx(byte%):got%=TRUE
 1150 UNTIL got% OR (TIME-start%>waitmax%)
 1160 IF NOT got% THEN PRINT "(no reply)":ENDPROC
 1170 last%=TIME
 1180 REPEAT
 1190   PROCwait
 1200   SYS "OS_SerialOp",4 TO ,byte%;flags%
 1210   IF (flags% AND mask%)=0 THEN PROCrx(byte%):last%=TIME
 1220 UNTIL TIME-last%>idlegap%
 1230 IF cur$<>"" THEN PRINT
 1240 ENDPROC
 1250 REM
 1260 DEF PROCwait
 1270 SYS "OS_Byte",19
 1280 ENDPROC
 1290 REM
 1300 DEF PROCrx(b%)
 1310 IF b%=13 OR b%=10 THEN PROCrxnl(b%):ENDPROC
 1320 IF b%<32 THEN ENDPROC
 1330 lastnl%=0
 1340 cur$=cur$+CHR$(b%)
 1350 VDU b%
 1360 IF LEN(cur$)>78 THEN PRINT:cur$=""
 1370 ENDPROC
 1380 REM
 1390 DEF PROCrxnl(b%)
 1400 IF lastnl%<>0 AND b%<>lastnl% THEN lastnl%=0:ENDPROC
 1410 PRINT:cur$="":lastnl%=b%
 1420 ENDPROC
 1430 REM
 1440 REM ==================== exit ====================
 1450 DEF PROCbye
 1460 SYS "OS_Byte",2,0
 1470 IF ERR<>0 AND ERR<>17 THEN PRINT'"Error ";ERR;": ";REPORT$;" at line ";ERL
 1480 PRINT "Link closed. Bye."
 1490 END
 1500 ENDPROC
