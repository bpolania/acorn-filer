   10 REM ACORNUI - ArmGPT Desktop/TaskWindow serial client
   20 REM --------------------------------------------------
   30 REM WIMP-safe BASIC version: no MODE changes, no full-screen VDU layout.
   40 REM Run it from a RISC OS Desktop TaskWindow or command window.
   50 REM Serial protocol matches ACORN: plain text plus newline.
   60 REM Ctrl-L toggles local/cloud; /quit exits locally.
   70 REM
  100 ON ERROR PROCbye
  110 PROCsetup
  120 PROCintro
  130 PROCloop
  140 PROCbye
  150 END
  160 REM
  170 REM ==================== setup ====================
  180 DEF PROCsetup
  190 SYS "OS_Byte",2,2
  200 VDU 4
  210 SYS "OS_SerialOp",0,4+32,0
  220 SYS "OS_SerialOp",1,0
  230 SYS "OS_SerialOp",5,7
  240 SYS "OS_SerialOp",6,7
  250 mask%=&02:waitmax%=12000:idlegap%=300
  260 maxin%=180:mode$="local":quit%=FALSE
  270 ENDPROC
  280 REM
  290 DEF PROCintro
  300 PRINT
  310 PRINT "ArmGPT Desktop client"
  320 PRINT "Serial link: 9600 baud, 8N1"
  330 PRINT "Commands: /status /mode local  /mode cloud  /quit"
  340 PROCstatus
  350 ENDPROC
  360 REM
  370 DEF PROCstatus
  380 PRINT "Mode: ";mode$
  390 ENDPROC
  400 REM
  410 REM ==================== main loop ====================
  420 DEF PROCloop
  430 REPEAT
  440   PROCprompt
  450   IF NOT quit% THEN PROCsubmit
  460 UNTIL quit%
  470 ENDPROC
  480 REM
  490 DEF PROCprompt
  500 q$=""
  510 PROCshowprompt
  520 REPEAT
  530   k%=GET
  540   CASE k% OF
  550     WHEN 13:PRINT:done%=TRUE
  560     WHEN 8,127:PROCbksp
  570     WHEN 12:PRINT:PROCtogglemode:PRINT:PROCredrawinput
  580     WHEN 27:q$="/quit":PRINT "/quit":done%=TRUE
  590     OTHERWISE
  600       IF k%>=32 AND k%<127 AND LEN(q$)<maxin% THEN q$=q$+CHR$(k%):PROCqchar(k%)
  610   ENDCASE
  620 UNTIL done%
  630 done%=FALSE
  640 ENDPROC
  650 REM
  660 DEF PROCshowprompt
  670 prompt$="you ("+mode$+") > "
  680 COLOUR 0:PRINT prompt$;
  690 qcol%=LEN(prompt$)
  700 ENDPROC
  710 REM
  720 DEF PROCqchar(b%)
  730 IF qcol%>=78 THEN PRINT:qcol%=0
  740 VDU b%:qcol%=qcol%+1
  750 ENDPROC
  760 REM
  770 DEF PROCbksp
  780 IF LEN(q$)=0 THEN ENDPROC
  790 IF qcol%=0 THEN VDU 7:ENDPROC
  800 q$=LEFT$(q$,LEN(q$)-1):qcol%=qcol%-1:VDU 8,32,8
  810 ENDPROC
  820 REM
  830 DEF PROCredrawinput
  840 LOCAL i%
  850 PROCshowprompt
  860 FOR i%=1 TO LEN(q$):PROCqchar(ASC(MID$(q$,i%,1))):NEXT
  870 ENDPROC
  880 REM
  890 DEF PROCsubmit
  900 IF q$="" THEN ENDPROC
  910 IF q$="/quit" THEN quit%=TRUE:ENDPROC
  920 PROCnotecmd(q$)
  930 tx$=q$:PROCwire
  940 PROCsend(tx$)
  950 PROCreceive
  960 ENDPROC
  970 REM
  980 DEF PROCtogglemode
  990 LOCAL cmd$
 1000 IF mode$="local" THEN cmd$="/mode cloud" ELSE cmd$="/mode local"
 1010 PRINT "you > ";cmd$
 1020 PROCnotecmd(cmd$)
 1030 tx$=cmd$:PROCwire
 1040 PROCsend(tx$)
 1050 PROCreceive
 1060 ENDPROC
 1070 REM
 1080 DEF PROCnotecmd(t$)
 1090 IF t$="/mode local" THEN mode$="local"
 1100 IF t$="/mode cloud" OR t$="/mode codex" THEN mode$="cloud"
 1110 ENDPROC
 1120 REM
 1130 DEF PROCwire
 1140 IF tx$="/mode cloud" THEN tx$="/mode codex"
 1150 IF LEFT$(tx$,7)="/cloud " THEN tx$="/codex "+MID$(tx$,8)
 1160 ENDPROC
 1170 REM
 1180 REM ==================== serial send/receive ====================
 1190 DEF PROCsend(t$)
 1200 LOCAL i%
 1210 FOR i%=1 TO LEN(t$):PROCtx(ASC(MID$(t$,i%,1))):NEXT
 1220 PROCtx(13):PROCtx(10)
 1230 ENDPROC
 1240 REM
 1250 DEF PROCtx(b%)
 1260 SYS "OS_SerialOp",3,b%
 1270 ENDPROC
 1280 REM
 1290 DEF PROCreceive
 1300 LOCAL byte%,flags%,start%,last%,got%
 1310 cur$="":lastnl%=0
 1320 COLOUR 4:PRINT "arm > ";:COLOUR 0
 1330 start%=TIME:got%=FALSE
 1340 REPEAT
 1350   PROCwait
 1360   SYS "OS_SerialOp",4 TO ,byte%;flags%
 1370   IF (flags% AND mask%)=0 THEN PROCrx(byte%):got%=TRUE
 1380 UNTIL got% OR (TIME-start%>waitmax%)
 1390 IF NOT got% THEN PRINT "(no reply)":ENDPROC
 1400 last%=TIME
 1410 REPEAT
 1420   PROCwait
 1430   SYS "OS_SerialOp",4 TO ,byte%;flags%
 1440   IF (flags% AND mask%)=0 THEN PROCrx(byte%):last%=TIME
 1450 UNTIL TIME-last%>idlegap%
 1460 IF cur$<>"" THEN PRINT
 1470 ENDPROC
 1480 REM
 1490 DEF PROCwait
 1500 SYS "OS_Byte",19
 1510 ENDPROC
 1520 REM
 1530 DEF PROCrx(b%)
 1540 IF b%=13 OR b%=10 THEN PROCrxnl(b%):ENDPROC
 1550 IF b%<32 THEN ENDPROC
 1560 lastnl%=0
 1570 cur$=cur$+CHR$(b%)
 1580 VDU b%
 1590 IF LEN(cur$)>78 THEN PRINT:cur$=""
 1600 ENDPROC
 1610 REM
 1620 DEF PROCrxnl(b%)
 1630 IF lastnl%<>0 AND b%<>lastnl% THEN lastnl%=0:ENDPROC
 1640 PRINT:cur$="":lastnl%=b%
 1650 ENDPROC
 1660 REM
 1670 REM ==================== exit ====================
 1680 DEF PROCbye
 1690 SYS "OS_Byte",2,0
 1700 IF ERR<>0 AND ERR<>17 THEN PRINT'"Error ";ERR;": ";REPORT$;" at line ";ERL
 1710 PRINT "Link closed. Bye."
 1720 END
 1730 ENDPROC
