10 REM Serial send-receive using OS_SerialOp,4,-1
20 VDU 4
30 SYS "OS_SerialOp",0,6,0:REM Set serial state
40 SYS "OS_SerialOp",1,0:REM 8N1 format
50 SYS "OS_SerialOp",5,7:REM 9600 baud receive
60 SYS "OS_SerialOp",6,7:REM 9600 baud transmit
70 REM Use *FX 8,0 if handshaking issues occur
80 mask%=&02:timeout%=6000
90 REPEAT
100   INPUT "Enter message to send: "msg$
110   IF msg$="" THEN msg$=" "
120   FOR i%=1 TO LEN(msg$)
130     SYS "OS_SerialOp",3,ASC(MID$(msg$,i%,1))
140   NEXT
150   SYS "OS_SerialOp",3,13:REM Send CR
160   PRINT "Message complete."
170   start%=TIME
180   REPEAT
190     SYS "OS_SerialOp",4,-1 TO ,b%;flags%
200   UNTIL (flags% AND mask%)=0 OR (TIME-start%>timeout%)
210   IF (flags% AND mask%)<>0 THEN PRINT "No response received.":GOTO 90
215   PRINT CHR$(b%);
220   last%=TIME
230   REPEAT
240     SYS "OS_SerialOp",4,-1 TO ,b%;flags%
250     IF (flags% AND mask%)=0 THEN PRINT CHR$(b%);:last%=TIME
260   UNTIL (TIME-last%>timeout%)
270   PRINT
280 UNTIL FALSE