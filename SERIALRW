10 VDU 4
20 SYS "OS_SerialOp",0,6,0
30 SYS "OS_SerialOp",1,0
40 SYS "OS_SerialOp",5,7
50 SYS "OS_SerialOp",6,7
60 mask%=&04
70 PRINT "Serial Read/Write (420/I version)"
80 PRINT "Type message and press Enter to send"
90 REPEAT
100   INPUT "Send: "msg$
110   IF msg$="" THEN msg$=" "
120   FOR i%=1 TO LEN(msg$)
130     SYS "OS_SerialOp",3,ASC(MID$(msg$,i%,1))
140   NEXT
150   SYS "OS_SerialOp",3,13
160   PRINT "Waiting for response..."
170   timeout%=TIME+3000
180   REPEAT
190     SYS "OS_SerialOp",4 TO s%
200     IF (s% AND mask%) THEN SYS "OS_SerialOp",2 TO b%:PRINT CHR$(b%);
210   UNTIL TIME>timeout%
220   PRINT
230 UNTIL FALSE