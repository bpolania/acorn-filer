10 REM ArmGPT - Serial Chat Client for Acorn Archimedes (RISC OS BASIC)
20 REM
30 REM Instructions:
40 REM - Type your prompt at the ">" and press Enter.
50 REM - ArmGPT sends your text to the serial port and prints the reply as it arrives.
60 REM - Press Enter on an empty line to quit.
70 REM

80 SYS "OS_Byte",2,2
90 VDU 4

95 REM ---- Intro screen ----
96 CLS
97 PRINT "  /$$$$$$                           /$$$$$$  /$$$$$$$  /$$$$$$$$"
98 PRINT " /$$__  $$                         /$$__  $$| $$__  $$|__  $$__/"
99 PRINT "| $$  \ $$  /$$$$$$  /$$$$$$/$$$$ | $$  \__/| $$  \ $$   | $$   "
100 PRINT "| $$$$$$$$ /$$__  $$| $$_  $$_  $$| $$ /$$$$| $$$$$$$/   | $$   "
101 PRINT "| $$__  $$| $$  \__/| $$ \ $$ \ $$| $$|_  $$| $$____/    | $$   "
102 PRINT "| $$  | $$| $$      | $$ | $$ | $$| $$  \ $$| $$         | $$   "
103 PRINT "| $$  | $$| $$      | $$ | $$ | $$|  $$$$$$/| $$         | $$   "
104 PRINT "|__/  |__/|__/      |__/ |__/ |__/ \______/ |__/         |__/   "
105 PRINT
106 PRINT "Press any key to continue..."
107 dummy%=GET
108 CLS
109 REM ----------------------

110 REM Serial setup (keep as-is for your current link settings)
120 SYS "OS_SerialOp",0,4+32,0
130 SYS "OS_SerialOp",1,9
140 SYS "OS_SerialOp",5,7
150 SYS "OS_SerialOp",6,7

160 PRINT "Type a prompt and press Enter. Empty line quits."
170 PRINT

180 REPEAT
190 INPUT ">", Q$
200 IF Q$="" THEN END

210 FOR i%=1 TO LEN(Q$)
220 SYS "OS_SerialOp",3,ASC(MID$(Q$,i%,1))
230 NEXT
240 SYS "OS_SerialOp",3,13
250 SYS "OS_SerialOp",3,10

260 REM Read and display response from serial (streams forever)
270 REPEAT
280 SYS "OS_SerialOp",4 TO byte%,; flags%
290 IF (flags% AND 2)=0 THEN
300 PRINT CHR$(byte%);
310 ENDIF
360 UNTIL FALSE

370 UNTIL FALSE