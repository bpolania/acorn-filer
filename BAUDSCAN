10 VDU 4
20 PRINT "Baud Rate Scanner (420/I version)"
30 SYS "OS_SerialOp",5,7
40 mask%=&04
50 FOR idx%=0 TO 15
60   SYS "OS_SerialOp",0,idx%,0
70   PRINT "Testing baud index ";idx%;"..."
80   count%=0:start%=TIME
90   REPEAT
100     SYS "OS_SerialOp",4 TO s%
110     IF (s% AND mask%) THEN SYS "OS_SerialOp",2 TO b%:count%=count%+1
120   UNTIL TIME-start%>200
130   IF count%>0 THEN PRINT "  Received ";count%;" bytes"
140 NEXT idx%
150 PRINT "Scan complete"