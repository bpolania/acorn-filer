   10 REM ACORN - ArmGPT serial chat client for RISC OS (RS-423)
   20 REM ----------------------------------------------------------
   30 REM Type a prompt at ">" and press RETURN. ACORN sends it over
   40 REM the serial port and prints the reply as it streams back.
   50 REM Press RETURN on an empty line (or ESCAPE) to quit.
   60 REM
   70 REM Improvements over SERIALRW:
   80 REM  * Reads the received byte from R1, not R0 (R0 stays = 4,
   90 REM    so the old code printed CHR$(4) instead of the reply).
  100 REM  * Returns to the ">" prompt after every reply, using an
  110 REM    idle-gap timer to detect when the reply has finished.
  120 REM  * Keyboard stays the input device (old code did OS_Byte 2,2,
  130 REM    which sent INPUT to the serial port).
  140 REM  * Re-sends bytes if the output buffer is full (handshaking).
  150 REM  * Normalises CR / LF / CRLF line endings from any sender.
  160 REM
  170 ON ERROR PROCbye
  180 PROCsetup
  190 PROCbanner
  200 REM
  210 REM ---- Tunables, in centiseconds (100 = 1 second) ----
  220 waitmax%=3000 :REM how long to wait for a reply to START (30s)
  230 idlegap%=300  :REM silence that means the reply has ENDED (3s)
  240 REM
  250 PROCscreen:done%=FALSE
  260 REPEAT
  270   COLOUR 3:PRINT "you > ";
  280   INPUT LINE ""q$
  290   COLOUR 7
  300   IF q$="" THEN done%=TRUE ELSE PROCsend(q$):PROCreply
  310 UNTIL done%
  320 PROCbye
  330 END
  340 REM
  350 REM ================= procedures =================
  360 REM
  370 DEF PROCsetup
  373 SYS "OS_Byte",135 TO ,,oldmode% :REM remember the mode we started in
  375 MODE 12                       :REM 80x32, 16 colours - the retro canvas
  380 SYS "OS_Byte",2,0             :REM keyboard is the input stream (rx still buffered)
  390 VDU 4                         :REM print text at the text cursor
  400 SYS "OS_SerialOp",0,4+32,0    :REM link/handshake state (your verified settings)
  410 SYS "OS_SerialOp",1,9         :REM data format (your verified settings)
  420 SYS "OS_SerialOp",5,7         :REM 9600 baud receive
  430 SYS "OS_SerialOp",6,7         :REM 9600 baud transmit
  440 ENDPROC
  450 REM
  460 DEF PROCsend(t$)
  470 LOCAL i%
  480 FOR i%=1 TO LEN(t$)
  490   PROCtx(ASC(MID$(t$,i%,1)))
  500 NEXT
  510 PROCtx(13):PROCtx(10)         :REM terminate the prompt with CR LF
  520 ENDPROC
  530 REM
  540 DEF PROCtx(b%)
  550 LOCAL f%
  560 REPEAT
  570   SYS "OS_SerialOp",3,b% TO ;f%
  580 UNTIL (f% AND 2)=0            :REM carry set (bit 1) = buffer full, retry
  590 ENDPROC
  600 REM
  610 DEF PROCreceive
  620 LOCAL byte%,flags%,start%,last%,got%
  630 lastnl%=0:got%=FALSE
  640 start%=TIME
  650 REM -- wait for the reply to start --
  660 REPEAT
  670   SYS "OS_SerialOp",4,-1 TO ,byte%;flags%
  680   IF (flags% AND 2)=0 THEN PROCshow(byte%):got%=TRUE
  690 UNTIL got% OR (TIME-start%>waitmax%)
  700 IF NOT got% THEN COLOUR 1:PRINT "...the line stays silent...":COLOUR 7:ENDPROC
  710 REM -- stream until the link falls idle --
  720 last%=TIME
  730 REPEAT
  740   SYS "OS_SerialOp",4,-1 TO ,byte%;flags%
  750   IF (flags% AND 2)=0 THEN PROCshow(byte%):last%=TIME
  760 UNTIL (TIME-last%>idlegap%)
  770 IF lastnl%=0 THEN PRINT       :REM tidy: newline if reply did not end with one
  780 ENDPROC
  790 REM
  800 REM Print one received byte, collapsing CR/LF/CRLF to one newline
  810 DEF PROCshow(b%)
  820 IF b%=13 OR b%=10 THEN PROCnewline(b%):ENDPROC
  830 IF b%<32 AND b%<>9 THEN ENDPROC :REM drop stray control codes (keep TAB)
  840 VDU b%:lastnl%=0
  850 ENDPROC
  860 REM
  870 DEF PROCnewline(b%)
  880 IF lastnl%<>0 AND b%<>lastnl% THEN lastnl%=0:ENDPROC :REM 2nd half of a CRLF/LFCR pair
  890 PRINT:lastnl%=b%
  900 ENDPROC
  910 REM
  920 DEF PROCbye
  925 MODE oldmode%                  :REM restore the mode we started in
  930 SYS "OS_Byte",2,0
  940 IF ERR<>0 AND ERR<>17 THEN PRINT'"Error ";ERR;": ";REPORT$;" at line ";ERL
  950 PRINT'"Link closed. Bye."
  960 END
  970 ENDPROC
  980 REM
  990 REM Full-screen splash: centres the wordmark, waits for RETURN
 1000 DEF PROCbanner
 1010 LOCAL cols%,rows%,i%,x%,y%,l$,artw%,arth%
 1020 artw%=44:arth%=6
 1030 SYS "OS_ReadModeVariable",-1,1 TO ,,cols%:cols%=cols%+1
 1040 SYS "OS_ReadModeVariable",-1,2 TO ,,rows%:rows%=rows%+1
 1050 IF cols%<artw% THEN cols%=artw%
 1060 CLS
 1070 x%=(cols%-artw%) DIV 2:IF x%<0 THEN x%=0
 1080 y%=(rows%-arth%) DIV 2-2:IF y%<3 THEN y%=3
 1090 COLOUR 6                     :REM cyan, nearest to the Arm teal
 1100 PRINT TAB(0,1);STRING$(cols%-1,"=")
 1110 PRINT TAB(0,rows%-2);STRING$(cols%-1,"=")
 1120 RESTORE 3000
 1130 FOR i%=0 TO arth%-1
 1140   READ l$
 1150   PRINT TAB(x%,y%+i%);l$
 1160 NEXT
 1170 COLOUR 7
 1180 PROCcentre(y%+arth%+1,cols%,"ChatGPT on a 1987 Acorn Archimedes")
 1190 COLOUR 6
 1200 PROCcentre(y%+arth%+2,cols%,"the machine that named ARM  .  now it talks back")
 1210 COLOUR 7
 1220 PROCcentre(rows%-5,cols%,"Press RETURN to continue")
 1230 REPEAT UNTIL GET=13           :REM wait for RETURN only
 1240 COLOUR 7:CLS
 1250 ENDPROC
 1260 REM
 1270 DEF PROCcentre(row%,cols%,t$)
 1280 PRINT TAB((cols%-LEN(t$)) DIV 2,row%);t$
 1290 ENDPROC
 1300 REM
 1310 REM Sierra-style screen: fixed status bar + scrolling window
 1320 DEF PROCscreen
 1330 LOCAL cols%,rows%,bar$,r$,pad%
 1340 SYS "OS_ReadModeVariable",-1,1 TO ,,cols%:cols%=cols%+1
 1350 SYS "OS_ReadModeVariable",-1,2 TO ,,rows%:rows%=rows%+1
 1360 REM -- top status bar: black on white, full width --
 1370 bar$=" ArmGPT":r$="a 1987 original "
 1380 pad%=cols%-1-LEN(bar$)-LEN(r$):IF pad%<1 THEN pad%=1
 1390 COLOUR 128+7:COLOUR 0
 1400 PRINT TAB(0,0);bar$;STRING$(pad%," ");r$;
 1410 REM -- conversation scrolls below the bar; row 0 stays put --
 1420 VDU 28,0,rows%-1,cols%-1,1
 1430 COLOUR 128+0:COLOUR 7:CLS
 1440 COLOUR 6:PRINT "ArmGPT is online. The serial link is open."
 1450 COLOUR 7:PRINT "Say something and press RETURN.  An empty line closes the link."
 1460 PRINT
 1470 ENDPROC
 1480 REM
 1490 REM Print the "arm >" speaker label, then stream the reply
 1500 DEF PROCreply
 1510 COLOUR 6:PRINT "arm > ";:COLOUR 7
 1520 PROCreceive
 1530 PRINT
 1540 ENDPROC
