10 VDU 4
20 SYS "OS_SerialOp",0,6,0
30 SYS "OS_SerialOp",1,0
40 SYS "OS_SerialOp",5,7
50 mask%=&04
60 PRINT "File Receiver (420/I version)"
70 PRINT "Waiting for data..."
80 timeout%=3000
90 start%=TIME
100 REPEAT
110   SYS "OS_SerialOp",4 TO s%
120 UNTIL (s% AND mask%) OR (TIME-start%>timeout%)
130 IF (s% AND mask%)=0 THEN PRINT "No data":END
140 file%=OPENOUT("RECEIVE")
150 PRINT "Receiving..."
160 bytes%=0:last%=TIME
170 REPEAT
180   SYS "OS_SerialOp",4 TO s%
190   IF (s% AND mask%) THEN SYS "OS_SerialOp",2 TO b%:BPUT#file%,b%:bytes%=bytes%+1:last%=TIME
200 UNTIL (TIME-last%>timeout%)
210 CLOSE#file%
220 PRINT "Received ";bytes%;" bytes"
230 SYS "OS_File",18,"RECEIVE",&FFB